# Vorlage: Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Die .env ist gitignored und wird nie committed.

# Bot-Token aus dem Discord Developer Portal (https://discord.com/developers/applications)
MAINBOT_TOKEN=your_bot_token_here

# Discord-User-IDs, die Bot-Befehle nutzen duerfen (kommagetrennt)
MAINBOT_AUTHORIZED_USERS=123456789012345678

# Discord-User-IDs der Bot-Owner (kommagetrennt)
MAINBOT_OWNERS=123456789012345678

# Guild-IDs (Server), auf denen der Bot laufen darf (kommagetrennt)
MAINBOT_ALLOWED_GUILDS=123456789012345678,234567890123456789

# Invite-Codes im Format name=code, getrennt durch Semikolons
MAINBOT_INVITES=server1=abcDEF1234;server2=ghiJKL5678
